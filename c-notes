          struct node *new_node;

    "2" Store data 
          new_node = malloc(sizeof(struct node));

    "3" Insert the node into the list
         (*new_node).value = 10;

    "4" Modify new node's next member to point to the node that was previously at the beginning of the list
          new_node->next = first;

    "5" Make *first point to the new node:
          first = new_node;

